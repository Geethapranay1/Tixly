generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum CreationSource {
  CHAT
}

enum MessageRole {
  USER
  ASSISTANT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         Role     @default(MEMBER)
  team         String?
  createdAt    DateTime @default(now()) @map("created_at")
  tickets      Ticket[]

  @@map("users")
}

model Ticket {
  id              String         @id @default(uuid())
  title           String
  description     String?
  assigneeId      String?        @map("assignee_id")
  assignee        User?          @relation(fields: [assigneeId], references: [id])
  dueDate         DateTime?      @map("due_date") @db.Date
  priority        Priority       @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  tags            String[]       @default([])
  language        String?
  sourceMessageId String?        @map("source_message_id")
  sourceMessage   ChatMessage?   @relation(fields: [sourceMessageId], references: [id])
  creationSource  CreationSource @default(CHAT) @map("creation_source")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@map("tickets")
}

model ChatSession {
  id               String        @id @default(uuid())
  sessionTokenHash String        @map("session_token_hash")
  pendingTicket    Json?         @map("pending_ticket")
  createdAt        DateTime      @default(now()) @map("created_at")
  messages         ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id                String      @id @default(uuid())
  sessionId         String      @map("session_id")
  session           ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role              MessageRole
  content           String
  detectedLanguage  String?     @map("detected_language")
  createdAt         DateTime    @default(now()) @map("created_at")
  tickets           Ticket[]

  @@index([sessionId])
  @@map("chat_messages")
}
