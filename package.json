{
  "name": "tixly",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @tixly/api dev",
    "dev:web": "pnpm --filter @tixly/web dev",
    "build": "pnpm -r run build",
    "test": "pnpm --filter @tixly/api test",
    "db:generate": "pnpm --filter @tixly/api db:generate",
    "db:migrate": "pnpm --filter @tixly/api db:migrate",
    "db:seed": "pnpm --filter @tixly/api db:seed",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines",
      "esbuild"
    ]
  }
}
